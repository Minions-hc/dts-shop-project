<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiguliuxing.dts.db.dao.LuckyDrawActivityMapper">

    <resultMap id="LuckyDrawActivityResultMap" type="com.qiguliuxing.dts.vo.LuckyDrawActivityVo">
        <id column="activity_id" property="activityId"/>
        <result column="period_number" property="periodNumber"/>
        <result column="activity_name" property="activityName"/>
        <result column="activity_rules" property="activityRules"/>
        <result column="draw_date" property="drawDate"/>
        <result column="activity_details" property="activityDetails"/>
        <result column="is_active" property="isActive"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.qiguliuxing.dts.vo.LuckyDrawActivityVo" useGeneratedKeys="true" keyProperty="activityId">
        INSERT INTO lucky_draw_activity
        (period_number, activity_name, activity_rules, draw_date, activity_details, is_active)
        VALUES
            (#{periodNumber}, #{activityName}, #{activityRules}, #{drawDate}, #{activityDetails}, #{isActive})
    </insert>

    <update id="update" parameterType="com.qiguliuxing.dts.vo.LuckyDrawActivityVo">
        UPDATE lucky_draw_activity
        SET
            period_number = #{periodNumber},
            activity_name = #{activityName},
            activity_rules = #{activityRules},
            draw_date = #{drawDate},
            activity_details = #{activityDetails},
            is_active = #{isActive},
            updated_at = NOW()
        WHERE activity_id = #{activityId}
    </update>

    <update id="setAllActivitiesInactive">
        UPDATE lucky_draw_activity set is_active = 0
    </update>

    <delete id="deleteById">
        DELETE FROM lucky_draw_activity WHERE activity_id = #{activityId}
    </delete>

    <select id="findById" resultMap="LuckyDrawActivityResultMap">
        SELECT * FROM lucky_draw_activity WHERE activity_id = #{activityId}
    </select>

    <select id="findAll" resultMap="LuckyDrawActivityResultMap">
        SELECT * FROM lucky_draw_activity ORDER BY period_number DESC
    </select>

    <select id="findByPeriodNumber" resultMap="LuckyDrawActivityResultMap">
        SELECT * FROM lucky_draw_activity WHERE period_number = #{periodNumber}
    </select>
</mapper>
